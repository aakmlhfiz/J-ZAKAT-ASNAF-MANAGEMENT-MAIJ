APP_NAME="J-ZAKAT"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE — MySQL only
# ============================================================
# Admin / system data lives in `j-zakat`
# Portal (pemohon) data lives in `j_zakat_user`
# Both databases must already exist on the MySQL server.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=j-zakat
DB_PORTAL_DATABASE=j_zakat_user
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================
# REVERB (Real-time WebSocket)
# ============================================================
REVERB_APP_ID=432033
REVERB_APP_KEY=replace-me-in-production
REVERB_APP_SECRET=replace-me-in-production
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================
# MAIL — Gmail SMTP
# ============================================================
# Set MAIL_MAILER=log during local development so emails are written to
# storage/logs/laravel.log instead of being sent. Switch to "smtp" once the
# Gmail App Password is provided.
MAIL_MAILER=log

# Untuk SMTP (Gmail):
# MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=akmal.hfiz204@gmail.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=akmal.hfiz204@gmail.com
MAIL_FROM_NAME="J-ZAKAT"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# J-ZAKAT — Konfigurasi khusus projek
# ============================================================

# Super Admin (mengurus kod undangan admin & akses ke Audit Log)
# Wajib diisi untuk akses kepada /app/admin-invitations dan /app/admin/audit-logs
MAIJ_SUPER_ADMIN_EMAIL=akmal.hfiz204@gmail.com
MAIJ_SUPER_ADMIN_NAME="Muhammad Akmal Hafiz"

# Firebase (Admin registration • Google sign-in)
# FIREBASE_CREDENTIALS=storage/app/j-zakat-firebase-adminsdk.json
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=

# AI Provider (mock | groq | openai | gemini | ollama)
# 'mock' adalah lalai — berfungsi offline tanpa API key
AI_PROVIDER=mock

# Groq (OpenAI-compatible, supports function calling)
# AI_PROVIDER=groq
# AI_GROQ_API_KEY=
# AI_GROQ_MODEL=openai/gpt-oss-120b
# AI_GROQ_BASE=https://api.groq.com/openai/v1
# AI_GROQ_TIMEOUT=30
# AI_GROQ_MAX_TOKENS=900

# OpenAI
# AI_OPENAI_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_OPENAI_BASE=https://api.openai.com/v1

# Google Gemini
# AI_GEMINI_API_KEY=
# AI_GEMINI_MODEL=gemini-1.5-flash

# Ollama (local LLM)
# AI_OLLAMA_HOST=http://127.0.0.1:11434
# AI_OLLAMA_MODEL=llama3.1

# OCR (tesseract | pdfparser | hybrid | mistral)
OCR_DRIVER=hybrid
# OCR_AI_RECOGNIZER=mock
# OCR_CONFIDENCE_THRESHOLD=70
# TESSERACT_PATH=tesseract
# TESSERACT_LANG=eng+msa
# OCR_MAX_FILE_SIZE=10240
# OCR_SYNC_FAST_PATH=true        # process text-layer PDFs synchronously on upload
# OCR_SYNC_SCAN=false            # OCR small scanned docs synchronously (opt-in)
# OCR_SYNC_SCAN_MAX_KB=2048
# OCR_PREPROCESS=false           # ImageMagick normalisation before Tesseract
# OCR_PREPROCESS_MIN_SIZE=1600
# OCR_PDF_IMAGE_DPI=220
# OCR_PDF_MAX_PAGES=5
# OCR_PAGE_MARKERS=true          # join multi-page OCR text with page markers

# OCRmyPDF (scanned-PDF engine) — requires Python + OCRmyPDF + QPDF
# OCR_MY_PDF_ENABLED=false
# OCR_MY_PDF_BINARY=python
# OCR_MY_PDF_LANG=eng+msa
# OCR_MY_PDF_TESSDATA_PREFIX=    # e.g. C:/Program Files/Tesseract-OCR/tessdata

# Mistral OCR (cloud) — requires a paid API key; OCR is NOT on the free tier.
# If the key is empty, the app falls back to the local hybrid pipeline.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-ocr-latest
# MISTRAL_TIMEOUT=60
# MISTRAL_MAX_PAGES=10
# MISTRAL_RETRY_ATTEMPTS=2

# Vision AI document understanding (GPT-Vision style) — renders each page and
# asks a vision model to understand the MAIJ form (labels, handwriting,
# checkboxes, tables, signatures). Falls back to the local pipeline when the
# provider is not configured or a call fails.
# OCR_VISION_ENABLED=false
# OCR_VISION_PROVIDER=openai        # openai | gemini | ollama | mock
# OCR_VISION_DPI=150
# OCR_VISION_MAX_PAGES=4
# OCR_VISION_TIMEOUT=120
# OCR_VISION_FALLBACK_LOCAL=true
# OCR_VISION_CONFIDENCE=60
# OpenAI (GPT Vision):
# OCR_VISION_OPENAI_MODEL=gpt-4o-mini
# Gemini:
# OCR_VISION_GEMINI_MODEL=gemini-2.0-flash
# Ollama (local vision, free):
# OCR_VISION_OLLAMA_MODEL=qwen2.5vl:7b

# ============================================================
# Peringatan Kemas Kini Gaji
# ============================================================
# Bilangan bulan selepas kelulusan sebelum peringatan kemas kini gaji dihantar
# kepada pemohon (emel). Job berjadual dijalankan setiap hari 08:00.
SALARY_REMINDER_MONTHS=12
